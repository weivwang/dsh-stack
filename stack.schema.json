{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-stack:schema:v1",
  "title": "dsh-stack Stackfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "name",
    "createdAt",
    "source",
    "bundles",
    "warnings",
    "integrity"
  ],
  "properties": {
    "format": { "const": "dsh-stack" },
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "minLength": 1, "maxLength": 120 },
        "harnessVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourceKind"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 214 },
          "specifier": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "installedVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sourceKind": {
            "enum": ["builtin", "registry", "git", "local", "other"]
          }
        }
      }
    },
    "profilePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "sha256", "secrets"],
      "properties": {
        "content": { "type": "string", "minLength": 1, "maxLength": 524288 },
        "sha256": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "secrets": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "env", "path"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "env": { "type": "string", "pattern": "^DSH_STACK_SECRET_[A-Z][A-Z0-9_]*$" },
              "path": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "integrity": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" }
  }
}
